{
  "uid": "harnessflow",
  "title": "HarnessFlow",
  "tags": ["harnessflow"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total workflow runs",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "harnessflow-prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "harnessflow-prometheus" },
          "expr": "sum(harnessflow_workflow_runs_total)"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total LLM cost (USD)",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "harnessflow-prometheus" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "harnessflow-prometheus" },
          "expr": "sum(harnessflow_llm_cost_usd_total)"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Workflow runs by status (rate)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "harnessflow-prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "harnessflow-prometheus" },
          "expr": "sum by (status) (rate(harnessflow_workflow_runs_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Workflow run duration (p50 / p95)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "harnessflow-prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line" } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "harnessflow-prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(harnessflow_workflow_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "harnessflow-prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(harnessflow_workflow_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "LLM tokens by model + direction (rate)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "harnessflow-prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "harnessflow-prometheus" },
          "expr": "sum by (model, type) (rate(harnessflow_llm_tokens_total[5m]))",
          "legendFormat": "{{model}} {{type}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "LLM cost by model (USD, cumulative)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "harnessflow-prometheus" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4, "custom": { "drawStyle": "line" } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "harnessflow-prometheus" },
          "expr": "sum by (model) (harnessflow_llm_cost_usd_total)",
          "legendFormat": "{{model}}"
        }
      ]
    }
  ]
}
