# Copy this file to `.env` and fill in real values.
# `.env` is gitignored. NEVER commit real secrets.

# --- LLM Providers ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=harnessflow
POSTGRES_PASSWORD=harnessflow
POSTGRES_DB=harnessflow

# --- Temporal ---
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=harnessflow-tasks

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=harnessflow
JAEGER_UI_URL=http://localhost:16686

# --- API ---
API_PORT=8080
API_KEY=dev-local-api-key-replace-me

# --- Dashboard ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Eval defaults ---
EVAL_JUDGE_MODEL=claude-sonnet-4-6
EVAL_LLM_BUDGET_USD=5.00

# --- Workflow optimizer (week 14) ---
OPTIMIZER_ENABLED=false
OPTIMIZER_DAILY_PR_CAP=3
OPTIMIZER_DAILY_BUDGET_USD=5.00
GH_TOKEN=
