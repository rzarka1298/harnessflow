# make dev reads .env literally: NAME=value or quoted literal values.
# Existing process environment wins. No export, expansion, or inline comments.
# No API provider keys are required for the PRD coding harness: run codex login.

DATABASE_URL=postgres://harnessflow:harnessflow@127.0.0.1:5432/harnessflow?sslmode=disable
TEMPORAL_HOST=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=harnessflow-tasks
API_HOST=127.0.0.1
API_PORT=8080
# make dev fixes dashboard origin to http://127.0.0.1:3001.
DASHBOARD_ORIGIN=http://127.0.0.1:3001

# Local Codex authentication is used by each agent attempt.
HARNESSFLOW_CODEX_BIN=codex
HARNESSFLOW_AGENT_TIMEOUT_SECONDS=1800
HARNESSFLOW_PROJECT_NETWORK=false
# Optional absolute worktree/log directory; default ~/.local/share/harnessflow.
# Do not use ~ in .env values (no shell expansion).
# HARNESSFLOW_DATA_DIR=/absolute/path/to/harnessflow-data

# Legacy YAML LLM workflows: real provider keys, or explicit mock for demos.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HARNESSFLOW_MOCK=0

# Optional observability/firehose; not required by make dev.
# Use localhost:4317 after make up to enable tracing and metrics.
OTEL_EXPORTER_OTLP_ENDPOINT_GRPC=
HARNESSFLOW_EVENTS_BROKERS=
